# Put your OpenRouter API key here, then run: source .env
# Do NOT commit or share this file.
export OPENROUTER_API_KEY="REPLACE_WITH_YOUR_OPENROUTER_KEY"

# Optional model override for later experiments
export OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional log file for Burp / prompt injection experiments
export PROMPT_INJECTION_LOG_PATH="results/prompt_injection_chat.jsonl"
